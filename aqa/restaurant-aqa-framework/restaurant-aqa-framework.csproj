<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Restaurant_Aqa_Framework</RootNamespace>
    <Version>1.0.0</Version>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- TreatWarningsAsErrors>true</TreatWarningsAsErrors -->
    <!-- `dotnet test`/`dotnet run` put TUnit's HTML/TRX/JSON next to Reqnroll's report and the traces (see Core/ArtifactPaths.cs). -->
    <TestingPlatformCommandLineArguments>--results-directory "$(MSBuildProjectDirectory)/TestResults"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Allure.Reqnroll" Version="2.15.0" />
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="dotenv.net" Version="4.2.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="Reqnroll.TUnit" Version="3.3.4" />
    <PackageReference Include="TUnit" Version="1.72.10" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="allureConfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
